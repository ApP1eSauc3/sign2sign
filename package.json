{
  "name": "sign2sign",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo export --platform web --output-dir dist",
    "web:dev": "expo start --web",
    "electron:dev": "electron electron/main.js",
    "electron:build": "npm run web && electron-builder build",
    "electron:build:mac": "npm run web && electron-builder build --mac && node build/stampUpdateMinimumOs.js",
    "electron:build:win": "npm run web && electron-builder build --win",
    "verify:electron": "node --check electron/main.js && node --check build/afterPack.js && node --check build/stampUpdateMinimumOs.js",
    "check:lines": "node scripts/check-lines.js",
    "verify:functions": "deno check supabase/functions/*/index.ts",
    "test:functions": "deno test supabase/functions/_shared/",
    "test:migrations": "node supabase/migration-tests/run.mjs",
    "audit:gate": "node scripts/audit-gate.js",
    "security:probe": "node scripts/probe-anon-surface.js",
    "auth:audit": "node scripts/auth-config-audit.js",
    "auth:apply-security": "node scripts/apply-security-settings.js",
    "auth:apply-templates": "node scripts/apply-auth-templates.js",
    "auth:apply-smtp": "node scripts/apply-smtp.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "@supabase/supabase-js": "^2.99.2",
    "electron-updater": "^6.8.9",
    "expo": "~55.0.7",
    "expo-auth-session": "~55.0.18",
    "expo-crypto": "~55.0.19",
    "expo-haptics": "~55.0.18",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-location": "~55.1.14",
    "expo-network": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electron/fuses": "^1.8.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "private": true
}
